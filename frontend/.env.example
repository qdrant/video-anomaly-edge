# Qdrant collection holding one point per clip: named vector "v_clip" (Twelve Labs Marengo),
# payload clip_id / source_video / feed_id / is_anomaly / severity / start_time / end_time.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=shanghaitech_clips

# Twelve Labs: text embeddings for /api/[dataset]/embeddings/search (same model as the clip embeddings)
TWELVE_LABS_API_KEY=
TWELVE_LABS_API_URL=https://api.twelvelabs.io/v1.3
TWELVE_LABS_EMBED_MODEL=marengo3.0

# Hosted mode: clips and thumbnails live on a static host (e.g. Vercel Blob) instead of ../data.
# /api/<dataset>/clips/<path> and /thumbnails/<path> redirect to $CLIP_BASE_URL/<dataset>/{clips,thumbnails}/<path>.
CLIP_BASE_URL=

# Optional: FastAPI backend for chat / Video Q&A / pipeline status panels
BACKEND_URL=http://localhost:9876
