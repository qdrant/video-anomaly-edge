FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

WORKDIR /app

RUN pip install --no-cache-dir \
    transformers \
    timm \
    decord \
    fastapi \
    "uvicorn[standard]" \
    numpy \
    pillow

COPY model_server.py .
COPY backend/model.py backend/model.py

EXPOSE 9877

CMD ["uvicorn", "model_server:app", "--host", "0.0.0.0", "--port", "9877"]
